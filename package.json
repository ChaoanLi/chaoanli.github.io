{
  "name": "chaoanli-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "test:now": "node --test scripts/now-archive.test.mjs",
    "sync:content": "node -e \"require('fs').cpSync('content', 'public/content', {recursive: true})\"",
    "dev": "npm run sync:content && npm run sync:research && vite",
    "build": "npm run sync:content && npm run sync:research && vite build && node scripts/create-route-entrypoints.mjs",
    "preview": "vite preview",
    "sync:research": "node -e \"require('fs').copyFileSync('data/validation-pvalues.csv', 'public/research/data/validation-pvalues.csv')\""
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.19.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^2.15.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
